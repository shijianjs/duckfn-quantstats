# name: test/sql/quantstats/html_report_benchmark.test
# description: duckfn_quantstats_html_benchmark 长表报告：配置参数放最后、按 benchmark_name 拆策略/基准、基准显示名、GROUP BY 每个标的、空输入 NULL，以及三条错误路径（缺基准标签 / 标签无匹配 / 一组混了多个策略）
# group: [quantstats]

require duckfn_quantstats

# ============================================================================
# 长表：一个标的占多行，用 name 区分策略与基准
#   fund = FUND_A / FUND_B，name ∈ {该标的自身, 'SPY'}
#   每个 (fund, 角色) 各 120 行，两条序列共用同一批日期
# ============================================================================

statement ok
CREATE TABLE fund_returns AS
SELECT f.fund,
       CASE WHEN b.is_bench THEN 'SPY' ELSE f.fund END AS name,
       (DATE '2024-01-01' + CAST(b.d // 2 AS INTEGER))::DATE AS dt,
       CAST(0.001 * ((b.d % 7) - 3) + CASE WHEN b.is_bench THEN 0.0002 ELSE 0.0 END AS DOUBLE) AS ret
FROM (VALUES ('FUND_A'), ('FUND_B')) f(fund),
     (SELECT CAST(i AS BIGINT) AS d, i % 2 = 1 AS is_bench FROM range(240) t(i)) b;

# 单组（一个标的一行一个标签）：报告能出来
query T
SELECT length(duckfn_quantstats_html_benchmark(
           name, dt, ret, {'benchmark_name': 'SPY'}::duckfn_quantstats_html_options)) > 1000 AS long_enough
FROM fund_returns WHERE fund = 'FUND_A';
----
true

# 基准显示名生效（benchmark_title 只影响展示）
query T
SELECT position('SPX' IN duckfn_quantstats_html_benchmark(
           name, dt, ret, {'benchmark_name': 'SPY', 'benchmark_title': 'SPX'}::duckfn_quantstats_html_options)) > 0 AS has_bench_title
FROM fund_returns WHERE fund = 'FUND_A';
----
true

# 不带基准显示名时报告里不会出现它，带上之后一定不同
query T
SELECT md5(duckfn_quantstats_html_benchmark(name, dt, ret, {'benchmark_name': 'SPY'}::duckfn_quantstats_html_options))
    <> md5(duckfn_quantstats_html_benchmark(
           name, dt, ret, {'benchmark_name': 'SPY', 'benchmark_title': 'SPX'}::duckfn_quantstats_html_options)) AS differs
FROM fund_returns WHERE fund = 'FUND_A';
----
true

# 配置参数在最后：把配置写在最前（本扩展早期的参数顺序）不再匹配任何签名
statement error
SELECT duckfn_quantstats_html_benchmark(
           {'benchmark_name': 'SPY'}::duckfn_quantstats_html_options, name, dt, ret)
FROM fund_returns WHERE fund = 'FUND_A';
----
No function matches the given name and argument types

# GROUP BY 每个标的：两组都能出报告（组内各只有一个策略标签 + 'SPY'）
query I
SELECT count(*) FROM (
    SELECT fund, duckfn_quantstats_html_benchmark(
               name, dt, ret, {'benchmark_name': 'SPY'}::duckfn_quantstats_html_options) AS html
    FROM fund_returns GROUP BY fund
) WHERE length(html) > 1000;
----
2

# 空输入 -> SQL NULL
query T
SELECT duckfn_quantstats_html_benchmark(
           name, dt, ret, {'benchmark_name': 'SPY'}::duckfn_quantstats_html_options) IS NULL AS is_null
FROM fund_returns WHERE dt > DATE '2100-01-01';
----
true

# 配置整体 NULL 时，基准标签缺失，因此下面这条会走进错误路径（而不是静默出一份没有基准的报告）
statement error
SELECT duckfn_quantstats_html_benchmark(name, dt, ret, NULL) FROM fund_returns WHERE fund = 'FUND_A';
----
'benchmark_name' is required

# ============================================================================
# 错误路径
# ============================================================================

# 没给基准标签：无法拆分策略与基准
statement error
SELECT duckfn_quantstats_html_benchmark(name, dt, ret, {'title': 'FUND_A'}::duckfn_quantstats_html_options)
FROM fund_returns WHERE fund = 'FUND_A';
----
'benchmark_name' is required

# 基准标签一行都没匹配上
statement error
SELECT duckfn_quantstats_html_benchmark(name, dt, ret, {'benchmark_name': 'QQQ'}::duckfn_quantstats_html_options)
FROM fund_returns WHERE fund = 'FUND_A';
----
no row matches benchmark_name = 'QQQ'

# 非基准行出现多个不同标签：一个分组里混了多个标的，报告会把它们合成一条曲线
statement error
SELECT duckfn_quantstats_html_benchmark(name, dt, ret, {'benchmark_name': 'SPY'}::duckfn_quantstats_html_options)
FROM fund_returns;
----
distinct strategy labels

# 组里只有基准行：没有可报告的策略
statement error
SELECT duckfn_quantstats_html_benchmark(name, dt, ret, {'benchmark_name': 'SPY'}::duckfn_quantstats_html_options)
FROM fund_returns WHERE name = 'SPY';
----
only rows labelled 'SPY'
