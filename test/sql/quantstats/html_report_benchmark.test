# name: test/sql/quantstats/html_report_benchmark.test
# description: duckfn_quantstats_html_benchmark 带基准报告：基准是「一次性传入的列表参数」（策略侧逐行聚合 + 单行 list 结果 cross join），配置参数放最后；覆盖 GROUP BY 每个标的、空输入 NULL、多线程一致性与五条错误路径
# group: [quantstats]

require duckfn_quantstats

# ============================================================================
# 数据：策略一张表（逐行），基准一张表（单独聚合一次）
#
# 关键点：`list(...)` 本身是聚合函数，**不能**内联写进聚合调用
# （DuckDB 会报 `aggregate function calls cannot be nested`），
# 必须先在一个子查询/CTE 里聚合成单行，再 cross join 进来。
# 这样基准序列只写一次、只求值一次，不会随分组数量重复出现。
# ============================================================================

statement ok
CREATE TABLE strategy_returns AS SELECT
    CASE WHEN i % 2 = 0 THEN 'FUND_A' ELSE 'FUND_B' END AS fund,
    (DATE '2024-01-01' + CAST(i // 2 AS INTEGER))::DATE AS trade_date,
    CAST(0.001 * ((i % 7) - 3) AS DOUBLE) AS daily_return
FROM range(240) t(i);

statement ok
CREATE TABLE benchmark_returns AS SELECT
    (DATE '2024-01-01' + CAST(i AS INTEGER))::DATE AS trade_date,
    CAST(0.0005 * ((i % 5) - 2) AS DOUBLE) AS daily_return
FROM range(120) t(i);

statement ok
CREATE TABLE benchmark_series AS
SELECT list({'date': trade_date, 'period_return': daily_return}) AS series FROM benchmark_returns;

# 基准点结构体与匿名 STRUCT(date DATE, period_return DOUBLE) 完全一致，所以不需要任何 cast
query T
SELECT typeof(series) FROM benchmark_series;
----
STRUCT(date DATE, period_return DOUBLE)[]

# 两个函数都是聚合，基准版本是 4 个参数
query I
SELECT len(parameters) FROM duckdb_functions() WHERE function_name = 'duckfn_quantstats_html_benchmark';
----
4

# ============================================================================
# 正常路径
# ============================================================================

# 单组：一个标的 + 一次传入的基准
query T
SELECT length(duckfn_quantstats_html_benchmark(
           s.trade_date, s.daily_return, b.series, NULL)) > 1000 AS long_enough
FROM strategy_returns s, benchmark_series b
WHERE s.fund = 'FUND_A';
----
true

# 基准显示名生效（benchmark_title 只影响展示）
query T
SELECT position('SPX' IN duckfn_quantstats_html_benchmark(
           s.trade_date, s.daily_return, b.series,
           {'title': 'My Fund', 'benchmark_title': 'SPX'}::duckfn_quantstats_html_options)) > 0 AS has_benchmark_title
FROM strategy_returns s, benchmark_series b
WHERE s.fund = 'FUND_A';
----
true

# 基准序列的日期范围比策略宽（120 天 vs 120 个交易日，起点相同），仍然能出报告：
# 起始日对齐由 quantstats-rs 按 match_dates 完成，这里不做额外处理。
query T
SELECT length(duckfn_quantstats_html_benchmark(
           s.trade_date, s.daily_return, b.series, NULL)) > 1000 AS ok
FROM strategy_returns s, benchmark_series b
WHERE s.fund = 'FUND_A';
----
true

# GROUP BY 每个标的：两组都出报告，且各自用自己的配置
query I
SELECT count(*) FROM (
    SELECT s.fund, duckfn_quantstats_html_benchmark(
               s.trade_date, s.daily_return, b.series,
               {'title': 'Fund ' || s.fund}::duckfn_quantstats_html_options) AS html
    FROM strategy_returns s, benchmark_series b
    GROUP BY s.fund
) WHERE length(html) > 1000 AND position('Fund FUND_' IN html) > 0;
----
2

# 空输入 -> SQL NULL（一组一行都没有）
query T
SELECT duckfn_quantstats_html_benchmark(
           s.trade_date, s.daily_return, b.series, NULL) IS NULL AS is_null
FROM strategy_returns s, benchmark_series b
WHERE s.trade_date > DATE '2100-01-01';
----
true

# ============================================================================
# combine：多线程下基准点只被搬运、不被重新解析，结果必须与单线程一致
# ============================================================================

statement ok
PRAGMA threads=1;

statement ok
CREATE TABLE benchmark_single_thread AS
SELECT md5(duckfn_quantstats_html_benchmark(
           s.trade_date, s.daily_return, b.series, NULL)) AS digest
FROM strategy_returns s, benchmark_series b
WHERE s.fund = 'FUND_A';

statement ok
PRAGMA threads=4;

query T
SELECT md5(duckfn_quantstats_html_benchmark(s.trade_date, s.daily_return, b.series, NULL))
     = (SELECT digest FROM benchmark_single_thread) AS same_as_single_thread
FROM strategy_returns s, benchmark_series b
WHERE s.fund = 'FUND_A';
----
true

statement ok
PRAGMA threads=1;

# ============================================================================
# 错误路径
# ============================================================================

# 基准为 NULL：函数名里就有 benchmark，没基准应当改用单序列版本
statement error
SELECT duckfn_quantstats_html_benchmark(s.trade_date, s.daily_return, NULL, NULL)
FROM strategy_returns s, benchmark_series b;
----
the benchmark list must not be NULL

# 基准为空列表
statement error
SELECT duckfn_quantstats_html_benchmark(
           s.trade_date, s.daily_return,
           []::STRUCT(date DATE, period_return DOUBLE)[], NULL)
FROM strategy_returns s, benchmark_series b;
----
the benchmark list is empty

# 基准点全都缺日期/收益（列表非空但没有任何有效点）
statement error
SELECT duckfn_quantstats_html_benchmark(
           s.trade_date, s.daily_return,
           (SELECT list({'date': NULL::DATE, 'period_return': NULL::DOUBLE}) FROM benchmark_returns LIMIT 1),
           NULL)
FROM strategy_returns s, benchmark_series b;
----
the benchmark list is empty

# 列表里有整体为 NULL 的元素
statement error
SELECT duckfn_quantstats_html_benchmark(
           s.trade_date, s.daily_return,
           [NULL::STRUCT(date DATE, period_return DOUBLE)],
           NULL)
FROM strategy_returns s, benchmark_series b;
----
cannot read the benchmark list

# list(...) 是聚合函数，不能内联当聚合参数
statement error
SELECT duckfn_quantstats_html_benchmark(
           s.trade_date, s.daily_return,
           list({'date': s.trade_date, 'period_return': s.daily_return}), NULL)
FROM strategy_returns s, benchmark_series b;
----
aggregate function calls cannot be nested

# 基准点的字段名写错（必须是 date / period_return）
statement error
SELECT duckfn_quantstats_html_benchmark(
           s.trade_date, s.daily_return,
           (SELECT list({'dt': trade_date, 'ret': daily_return}) FROM benchmark_returns), NULL)
FROM strategy_returns s, benchmark_series b;
----
No function matches the given name and argument types

# 参数顺序不对：配置不在最后 / 基准不在第三位
statement error
SELECT duckfn_quantstats_html_benchmark(NULL, s.trade_date, s.daily_return)
FROM strategy_returns s, benchmark_series b;
----
No function matches the given name and argument types
