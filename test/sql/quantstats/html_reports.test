# name: test/sql/quantstats/html_reports.test
# description: qs_html_reports 收益率路径：单签名（4 参）、结果形状 list<struct{symbol, benchmark, strategy_title, benchmark_title, html, file_path}>、无基准时 benchmark / benchmark_title 为 NULL、一个标的对多个基准出多份（按基准列表顺序）、基准只作输入、两个显示名回显且缺项各自退回 symbol、NULL 行跳过、空输入 NULL、多线程 combine 一致性、output_dir 自动命名与路径回填、两次调用互不覆盖
# group: [quantstats]

require duckfn_quantstats

# ============================================================================
# 注册面：两个名字、各一个签名
#
# 基准是配置里的一个键（一个 symbol 列表），不占参数位，所以两个函数都只剩 4 参这一个签名。
# 落盘也从「给完整路径」变成了「只给目录」的 output_dir：文件名由函数按 naming.rs 的规则生成。
# ============================================================================

query I
SELECT count(*) FROM duckdb_types() WHERE type_name = 'qs_html_report_options';
----
1

# 字段名都不是 SQL 关键字，所以 DuckDB 渲染 typeof 时不加引号。
# `benchmark` 与 `benchmark_title` 都是列表：前者是 symbol 名，后者按下标与它一一对应。
query T
SELECT typeof(NULL::qs_html_report_options);
----
STRUCT(title VARCHAR, strategy_title VARCHAR, benchmark_title VARCHAR[], benchmark VARCHAR[], rf DOUBLE, periods_per_year UINTEGER, match_dates BOOLEAN, output_dir VARCHAR, open_in_browser BOOLEAN)

query I
SELECT count(*) FROM duckdb_functions()
WHERE function_name IN ('qs_html_reports', 'qs_html_reports_by_prices')
  AND function_type = 'aggregate'
  AND len(parameters) = 4;
----
2

# 旧名字已整体替换（0.1.0 起不做兼容）：SQL 里只剩这两个
query T rowsort
SELECT function_name FROM duckdb_functions() WHERE function_name LIKE 'qs_html_report%';
----
qs_html_reports
qs_html_reports_by_prices

statement error
SELECT qs_html_report(1, 2, 3);
----
Scalar Function with name qs_html_report does not exist

# ============================================================================
# 数据：四个 symbol —— AAA/BBB 出报告，SPX/NDX 当基准（基准就是普通的 symbol）
# ============================================================================

statement ok
CREATE TABLE daily_returns AS SELECT
    CASE WHEN i % 4 = 3 THEN 'SPX' WHEN i % 4 = 2 THEN 'NDX' WHEN i % 4 = 0 THEN 'AAA' ELSE 'BBB' END AS symbol,
    (DATE '2024-01-01' + CAST(i // 4 AS INTEGER))::DATE AS trade_date,
    CAST(0.001 * ((i % 7) - 3) AS DOUBLE) AS daily_return
FROM range(160) t(i);

# ============================================================================
# 返回形状与分组
# ============================================================================

query T
SELECT typeof(qs_html_reports(symbol, trade_date, daily_return, NULL)) FROM daily_returns;
----
STRUCT(symbol VARCHAR, benchmark VARCHAR, strategy_title VARCHAR, benchmark_title VARCHAR, html VARCHAR, file_path VARCHAR)[]

# 不带基准：每个 symbol 一行、benchmark 为 NULL、顺序按 symbol 升序
query T
SELECT list((r).symbol || '/' || coalesce((r).benchmark, 'none')) FROM (
    SELECT unnest(qs_html_reports(symbol, trade_date, daily_return, NULL)) AS r FROM daily_returns
);
----
[AAA/none, BBB/none, NDX/none, SPX/none]

# 一个标的对两个基准 = 两份报告；被指为基准的 symbol 自己不出报告
query T
SELECT list((r).symbol || '/' || coalesce((r).benchmark, 'none')) FROM (
    SELECT unnest(qs_html_reports(symbol, trade_date, daily_return,
                   {'benchmark': ['SPX', 'NDX']}::qs_html_report_options)) AS r FROM daily_returns
);
----
[AAA/SPX, AAA/NDX, BBB/SPX, BBB/NDX]

# 基准列表的顺序就是同一标的下各份报告的顺序
# （只留 AAA 与两个基准：基准行必须在表里，而 BBB 的行在这里不需要）
query T
SELECT list((r).benchmark) FROM (
    SELECT unnest(qs_html_reports(symbol, trade_date, daily_return,
                   {'benchmark': ['NDX', 'SPX']}::qs_html_report_options)) AS r
    FROM daily_returns WHERE symbol <> 'BBB'
);
----
[NDX, SPX]

# 每一份报告说的都是它自己那个基准（基准显示名缺省退回基准 symbol）
query I
SELECT count(*) FROM (
    SELECT unnest(qs_html_reports(symbol, trade_date, daily_return,
                   {'benchmark': ['SPX', 'NDX']}::qs_html_report_options)) AS r FROM daily_returns
) WHERE position('Benchmark is ' || (r).benchmark IN (r).html) > 0;
----
4

# 显示名没写就退回 symbol；没配 output_dir 时 file_path 是 NULL；html 确实是一份完整报告
query I
SELECT count(*) FROM (
    SELECT unnest(qs_html_reports(symbol, trade_date, daily_return,
                   {'benchmark': ['SPX', 'NDX']}::qs_html_report_options)) AS r FROM daily_returns
) WHERE (r).strategy_title = (r).symbol
    AND (r).benchmark_title = (r).benchmark
    AND (r).file_path IS NULL AND length((r).html) > 1000;
----
4

# 基准显示名回显在结果里：写了 benchmark_title 就是它，缺项（列表短了）退回那一份的基准 symbol
# （基准那两行也得在输入里，所以这里滤掉 BBB 而不是滤掉基准）
query T
SELECT array_to_string(list((r).benchmark || '=' || (r).benchmark_title), ' | ') FROM (
    SELECT unnest(qs_html_reports(symbol, trade_date, daily_return,
                   {'benchmark': ['SPX', 'NDX'],
                    'benchmark_title': ['S&P 500']}::qs_html_report_options)) AS r
    FROM daily_returns WHERE symbol <> 'BBB'
);
----
SPX=S&P 500 | NDX=NDX

# 没有基准时 benchmark 与 benchmark_title 一起是 NULL（单序列报告没有基准可指、也没有基准名）
query I
SELECT count(*) FROM (
    SELECT unnest(qs_html_reports(symbol, trade_date, daily_return, NULL)) AS r FROM daily_returns
) WHERE (r).benchmark IS NULL AND (r).benchmark_title IS NULL;
----
4

# 整体 NULL 配置 = 全默认：默认标题 "Strategy Tearsheet"
query I
SELECT count(*) FROM (
    SELECT unnest(qs_html_reports(symbol, trade_date, daily_return, NULL)) AS r FROM daily_returns
) WHERE position('Strategy Tearsheet' IN (r).html) > 0;
----
4

# 每个标的那一份用的是**它自己**那份配置（这里用 symbol 列把标题与显示名拼出来）
query I
SELECT count(*) FROM (
    SELECT unnest(qs_html_reports(symbol, trade_date, daily_return,
                   {'title': symbol, 'strategy_title': symbol}::qs_html_report_options)) AS r
    FROM daily_returns
) WHERE (r).strategy_title = (r).symbol AND position('Metrics' IN (r).html) > 0;
----
4

# periods_per_year 真的传下去了：改了它，报告里的年化数字会变，所以 md5 不同
query T
SELECT (SELECT md5((r).html) FROM (
            SELECT unnest(qs_html_reports(symbol, trade_date, daily_return, NULL)) AS r FROM daily_returns
        ) WHERE (r).symbol = 'AAA')
     <> (SELECT md5((r).html) FROM (
            SELECT unnest(qs_html_reports(symbol, trade_date, daily_return,
                           {'periods_per_year': 52}::qs_html_report_options)) AS r FROM daily_returns
        ) WHERE (r).symbol = 'AAA') AS differs;
----
true

# 不带 :: 的 struct 字面量是匿名 STRUCT(title VARCHAR)，与配置类型的字段数不匹配，必须显式 cast
statement error
SELECT qs_html_reports(symbol, trade_date, daily_return, {'title': 'My Fund'}) FROM daily_returns;
----
No function matches the given name and argument types

# ============================================================================
# 边界：空输入 -> SQL NULL；NULL 行被整行跳过；被跳空的 symbol 不出报告
# ============================================================================

query T
SELECT qs_html_reports(symbol, trade_date, daily_return, NULL) IS NULL AS is_null
FROM daily_returns WHERE trade_date > DATE '2100-01-01';
----
true

statement ok
CREATE TABLE returns_with_nulls AS
SELECT * FROM daily_returns
UNION ALL SELECT NULL, DATE '2024-01-01', 0.5::DOUBLE
UNION ALL SELECT 'ZZZ', NULL, 0.5::DOUBLE
UNION ALL SELECT 'ZZZ', DATE '2024-01-01', NULL::DOUBLE;

# 多塞的 NULL 行不影响任何一份报告：AAA 的那份与干净数据逐字节一致
query T
SELECT (SELECT md5((r).html) FROM (
            SELECT unnest(qs_html_reports(symbol, trade_date, daily_return, NULL)) AS r FROM returns_with_nulls
        ) WHERE (r).symbol = 'AAA')
     = (SELECT md5((r).html) FROM (
            SELECT unnest(qs_html_reports(symbol, trade_date, daily_return, NULL)) AS r FROM daily_returns
        ) WHERE (r).symbol = 'AAA') AS same_as_clean;
----
true

# 只有 NULL 行的 symbol 根本进不了结果（它没有一行有效数据）
query I
SELECT count(*) FROM (
    SELECT unnest(qs_html_reports(symbol, trade_date, daily_return, NULL)) AS r FROM returns_with_nulls
) WHERE (r).symbol = 'ZZZ';
----
0

# ============================================================================
# combine：多线程会把一张表拆成多个状态再合并，结果必须与单线程逐字节一致
#
# 这是「combine 只合并 symbol 表、点的排序交给 ReturnSeries::new」以及「每个 symbol 的配置只解析一次、
# 合并时只搬运解析结果」两条设计的端到端验证；带基准时每个标的还会多出几份报告，一并核对。
# ============================================================================

statement ok
CREATE TABLE big_returns AS SELECT
    'F' || (i % 4) AS symbol,
    (DATE '2020-01-01' + CAST(i // 4 AS INTEGER))::DATE AS trade_date,
    CAST(0.001 * ((i % 11) - 5) AS DOUBLE) AS daily_return
FROM range(20000) t(i);

statement ok
PRAGMA threads=1;

statement ok
CREATE TABLE big_single_thread AS
SELECT list((r).symbol || '/' || coalesce((r).benchmark, 'none')) AS rows,
       md5(string_agg(md5((r).html), ',' ORDER BY (r).symbol, (r).benchmark)) AS digests
FROM (
    SELECT unnest(qs_html_reports(symbol, trade_date, daily_return,
                   {'benchmark': ['F0', 'F1']}::qs_html_report_options)) AS r
    FROM big_returns
);

statement ok
PRAGMA threads=4;

query T
SELECT (list((r).symbol || '/' || coalesce((r).benchmark, 'none')) = (SELECT rows FROM big_single_thread))
   AND (md5(string_agg(md5((r).html), ',' ORDER BY (r).symbol, (r).benchmark)) = (SELECT digests FROM big_single_thread)) AS same_as_single_thread
FROM (
    SELECT unnest(qs_html_reports(symbol, trade_date, daily_return,
                   {'benchmark': ['F0', 'F1']}::qs_html_report_options)) AS r
    FROM big_returns
);
----
true

statement ok
PRAGMA threads=1;

# ============================================================================
# 报告落盘（output_dir）：只给目录，文件名由函数生成
#
# 走 **DuckDB 的 VFS**（duckfn 便捷层 duck_vfs::write_string 背后的 DuckDB 文件系统），不是 std::fs。
# __TEST_DIR__ 是测试运行器给的临时目录。
# ============================================================================

statement ok
CREATE TABLE written AS
SELECT (r).symbol AS symbol, (r).benchmark AS benchmark, (r).html AS html, (r).file_path AS file_path
FROM (
    SELECT unnest(qs_html_reports(symbol, trade_date, daily_return,
                   {'benchmark': ['SPX', 'NDX'],
                    'output_dir': '__TEST_DIR__'}::qs_html_report_options)) AS r
    FROM daily_returns
);

# 每份报告一个文件，路径落在 output_dir 下、后缀是 .html
query I
SELECT count(*) FROM written
WHERE starts_with(file_path, '__TEST_DIR__/') AND ends_with(file_path, '.html');
----
4

# 文件名由函数按 naming.rs 的规则生成：`<时间>-<策略名>-<基准名>-<随机尾缀>.html`。
# 去掉时间戳与随机尾缀之后，剩下的正好是「显示名」那两段。
query T
SELECT list_sort(list(
           regexp_replace(
               regexp_replace(regexp_extract(file_path, '[^/]+$'), '^[0-9]{8}-[0-9]{6}-', ''),
               '-[0-9a-f]{8}\.html$', ''
           )
       ))
FROM written;
----
[AAA-NDX, AAA-SPX, BBB-NDX, BBB-SPX]

# 落盘内容与返回行里的 html 逐字节一致（read_text 读回来的是文件内容；glob 覆盖所有刚写下的文件）
query I
SELECT count(*) FROM written w
WHERE NOT EXISTS (
    SELECT 1 FROM read_text('__TEST_DIR__/*.html') f WHERE md5(f.content) = md5(w.html)
);
----
0

# 再跑一次同样的查询：文件名带时间与随机尾缀，所以没有任何一份盖掉上一份
statement ok
CREATE TABLE written_again AS
SELECT (r).symbol AS symbol, (r).benchmark AS benchmark, (r).file_path AS file_path
FROM (
    SELECT unnest(qs_html_reports(symbol, trade_date, daily_return,
                   {'benchmark': ['SPX', 'NDX'],
                    'output_dir': '__TEST_DIR__'}::qs_html_report_options)) AS r
    FROM daily_returns
);

query I
SELECT count(*) FROM written w JOIN written_again a USING (symbol, benchmark)
WHERE w.file_path = a.file_path;
----
0

# ============================================================================
# open_in_browser：测试只覆盖能安全断言的两件事
#
# 真正「把浏览器叫起来」没法在这里断言（那会在跑测试的机器上弹出窗口）。
# ============================================================================

# 关着的开关与不写这个键完全等价：md5 相同（新增字段没有扰动任何既有行为）
query T
SELECT (SELECT md5((r).html) FROM (
            SELECT unnest(qs_html_reports(symbol, trade_date, daily_return, NULL)) AS r FROM daily_returns
        ) WHERE (r).symbol = 'AAA')
     = (SELECT md5((r).html) FROM (
            SELECT unnest(qs_html_reports(symbol, trade_date, daily_return,
                           {'open_in_browser': false}::qs_html_report_options)) AS r FROM daily_returns
        ) WHERE (r).symbol = 'AAA') AS same_as_unset;
----
true

# 浏览器只能打开本地文件：output_dir 指向 s3:// 这类 VFS 路径时直接报错，而且要报在渲染之前
# （这里连 httpfs 都没装，报的必须是配置错误而不是写入错误）
statement error
SELECT qs_html_reports(symbol, trade_date, daily_return,
           {'benchmark': ['SPX'],
            'output_dir': 's3://bucket/reports',
            'open_in_browser': true}::qs_html_report_options)
FROM daily_returns;
----
only local file paths can be opened in a browser
