# name: test/sql/quantstats/html_reports_values.test
# description: 用 webbed 的 XPath 解析生成的 HTML，断言报告里的**真实值**：标题与统计区间、配置项回显（rf 年化口径 / strategy_title / benchmark_title）、逐行指标数字、图表与表格数量、多个基准时每份报告各自带自己的基准列、基准显示名按下标对齐 benchmark 且缺项退回 symbol、以及每个 symbol 各自的标题与 output_dir 落盘文件名
# group: [quantstats]
#
# 注意：本文件依赖社区扩展 webbed（`INSTALL webbed FROM community`），首次运行需要网络；
# 装好后会落在用户的 DuckDB 扩展缓存里，之后离线也能跑。
#
# 其它三个 .test 文件不依赖任何外部扩展：它们用 md5 相等性与 length/position 做断言，
# 覆盖的是「分组、配置解析、NULL 处理、多线程 combine 一致性、落盘、错误路径」这些**行为**；
# 本文件补的是「输出内容确实对」——两边的分工不要混。

require duckfn_quantstats

statement ok
INSTALL webbed FROM community;

statement ok
LOAD webbed;

# ============================================================================
# 数据：一张长表，三个 symbol —— FUND（标的）与 SPX / NDX（两个基准用），交易日历一致
# ============================================================================

statement ok
CREATE TABLE daily_returns AS
SELECT 'FUND' AS symbol, trade_date, daily_return FROM (VALUES
    (DATE '2024-01-02', 0.0100::DOUBLE),
    (DATE '2024-01-03', -0.0200::DOUBLE),
    (DATE '2024-01-04', 0.0300::DOUBLE),
    (DATE '2024-01-05', 0.0000::DOUBLE),
    (DATE '2024-01-08', 0.0150::DOUBLE),
    (DATE '2024-01-09', -0.0050::DOUBLE),
    (DATE '2024-01-10', 0.0200::DOUBLE),
    (DATE '2024-01-11', -0.0100::DOUBLE),
    (DATE '2024-01-12', 0.0050::DOUBLE)
) t(trade_date, daily_return)
UNION ALL
SELECT 'SPX' AS symbol, trade_date, daily_return FROM (VALUES
    (DATE '2024-01-02', 0.0020::DOUBLE),
    (DATE '2024-01-03', -0.0010::DOUBLE),
    (DATE '2024-01-04', 0.0040::DOUBLE),
    (DATE '2024-01-05', 0.0010::DOUBLE),
    (DATE '2024-01-08', -0.0020::DOUBLE),
    (DATE '2024-01-09', 0.0030::DOUBLE),
    (DATE '2024-01-10', 0.0000::DOUBLE),
    (DATE '2024-01-11', 0.0025::DOUBLE),
    (DATE '2024-01-12', 0.0015::DOUBLE)
) t(trade_date, daily_return)
UNION ALL
SELECT 'NDX' AS symbol, trade_date, daily_return FROM (VALUES
    (DATE '2024-01-02', -0.0010::DOUBLE),
    (DATE '2024-01-03', 0.0050::DOUBLE),
    (DATE '2024-01-04', -0.0030::DOUBLE),
    (DATE '2024-01-05', 0.0020::DOUBLE),
    (DATE '2024-01-08', 0.0040::DOUBLE),
    (DATE '2024-01-09', -0.0010::DOUBLE),
    (DATE '2024-01-10', 0.0010::DOUBLE),
    (DATE '2024-01-11', -0.0020::DOUBLE),
    (DATE '2024-01-12', 0.0030::DOUBLE)
) t(trade_date, daily_return);

statement ok
CREATE TABLE single_report AS
SELECT (r).html AS html FROM (
    SELECT unnest(qs_html_reports(symbol, trade_date, daily_return,
        {'title': 'My Fund', 'strategy_title': 'My Fund', 'rf': 0.04}::qs_html_report_options)) AS r
    FROM daily_returns WHERE symbol = 'FUND'
);

# 只留 FUND 与基准 SPX：NDX 在这一段里不该出报告（表里没别的标的，读起来也更清楚）
statement ok
CREATE TABLE benchmark_report AS
SELECT (r).benchmark AS benchmark, (r).html AS html FROM (
    SELECT unnest(qs_html_reports(symbol, trade_date, daily_return,
        {'title': 'My Fund', 'strategy_title': 'My Fund', 'benchmark': ['SPX'],
         'benchmark_title': ['Bench'], 'rf': 0.04}::qs_html_report_options)) AS r
    FROM daily_returns WHERE symbol <> 'NDX'
);

# webbed 的 html_extract_text(html, xpath) 返回 VARCHAR[]（所有匹配项），所以要么取 [1]，要么用 array_to_string 拼起来。

# ============================================================================
# 单序列：标题、统计区间、配置回显
# ============================================================================

# h1 = `{{title}}` + `<dt>` 统计区间
query T
SELECT html_extract_text(html, '//h1')[1] FROM single_report;
----
My Fund 2 Jan, 2024 - 12 Jan, 2024

# 统计区间取自数据自身的首尾日期（格式 %e %b, %Y，个位数字前面不留空格）
query T
SELECT html_extract_text(html, '//h1/dt')[1] FROM single_report;
----
2 Jan, 2024 - 12 Jan, 2024

# 指标表的表头用的是 strategy_title
query T
SELECT array_to_string(html_extract_text(html, '//div[@id="right"]/table[1]//thead/tr/th'), ' | ') FROM single_report;
----
Metric | My Fund

# rf 是**年化**口径：传 0.04 应当原样显示成 4.0%
# （crate 内部才把它换算成周期利率，报告表格里显示的就是年化值）
query T
SELECT html_extract_text(html, '//div[@id="right"]/table[1]//tr[td[1]="Risk-Free Rate"]/td[2]')[1] FROM single_report;
----
4.0%

# ============================================================================
# 单序列：逐行指标的真实数字（固定输入 => 固定值）
#
# 这几个数字走完了整条链路：DuckDate -> NaiveDate 换算、按日期排序、指标计算、模板渲染。
# 如果 quantstats-rs 换了算法，这里会红 —— 那正是我们想被通知的时刻。
# ============================================================================

query T
SELECT html_extract_text(html, '//div[@id="right"]/table[1]//tr[td[1]="Cumulative Return"]/td[2]')[1] FROM single_report;
----
4.49%

query T
SELECT html_extract_text(html, '//div[@id="right"]/table[1]//tr[td[1]="Max Drawdown"]/td[2]')[1] FROM single_report;
----
-2.00%

query T
SELECT html_extract_text(html, '//div[@id="right"]/table[1]//tr[td[1]="Sharpe"]/td[2]')[1] FROM single_report;
----
4.93

query T
SELECT html_extract_text(html, '//div[@id="right"]/table[1]//tr[td[1]="Best Day"]/td[2]')[1] FROM single_report;
----
3.00%

query T
SELECT html_extract_text(html, '//div[@id="right"]/table[1]//tr[td[1]="Worst Day"]/td[2]')[1] FROM single_report;
----
-2.00%

# ============================================================================
# 单序列：页面结构（图表与表格确实被渲染出来了，而不只是一个能通过 length 检查的字符串）
# ============================================================================

query I
SELECT array_length(html_extract_text(html, '//svg')) FROM single_report;
----
10

query I
SELECT array_length(html_extract_text(html, '//table')) FROM single_report;
----
3

query I
SELECT array_length(html_extract_text(html, '//h3')) FROM single_report;
----
3

# 没有基准时，指标表每行只有「标签 + 策略」两列
query I
SELECT len(html_extract_text(html, '//div[@id="right"]/table[1]//tr[td[1]="Risk-Free Rate"]/td')) FROM single_report;
----
2

# ============================================================================
# 一个基准：基准显示名生效、指标表多一列、两列取值不同、基准那个 symbol 不出报告
# ============================================================================

query I
SELECT count(*) FROM benchmark_report;
----
1

query T
SELECT html_extract_text(html, '//h4')[1] FROM benchmark_report;
----
Benchmark is Bench |  Generated by QuantStats-RS (v. 0.1.0)

query T
SELECT array_to_string(html_extract_text(html, '//div[@id="right"]/table[1]//thead/tr/th'), ' | ') FROM benchmark_report;
----
Metric | Bench | My Fund

# 有基准时每行三列（标签 + 基准 + 策略）
query I
SELECT len(html_extract_text(html, '//div[@id="right"]/table[1]//tr[td[1]="Risk-Free Rate"]/td')) FROM benchmark_report;
----
3

# 指标表的列顺序是「基准在前、策略在后」
query T
SELECT array_to_string(html_extract_text(html, '//div[@id="right"]/table[1]//tr[td[1]="Sharpe"]/td'), ' | ') FROM benchmark_report;
----
Sharpe | 8.74 | 4.93

# 策略列的 Sharpe 与单序列报告里的完全一致：加基准不会改动策略侧的指标
query T
SELECT html_extract_text(html, '//div[@id="right"]/table[1]//tr[td[1]="Sharpe"]/td')[3]
     = (SELECT html_extract_text(html, '//div[@id="right"]/table[1]//tr[td[1]="Sharpe"]/td[2]')[1] FROM single_report)
FROM benchmark_report;
----
true

# ============================================================================
# 多个基准：一个标的出多份报告，每份只跟**它自己**那个基准比
# ============================================================================

statement ok
CREATE TABLE multi_report AS
SELECT (r).benchmark AS benchmark, (r).html AS html FROM (
    SELECT unnest(qs_html_reports(symbol, trade_date, daily_return,
        {'title': 'My Fund', 'strategy_title': 'My Fund',
         'benchmark': ['SPX', 'NDX'], 'rf': 0.04}::qs_html_report_options)) AS r
    FROM daily_returns
);

query I
SELECT count(*) FROM multi_report;
----
2

# 每份报告的基准说明写的是它自己那个基准（benchmark_title 缺省退回基准 symbol）
query T
SELECT html_extract_text(html, '//h4')[1] FROM multi_report WHERE benchmark = 'SPX';
----
Benchmark is SPX |  Generated by QuantStats-RS (v. 0.1.0)

query T
SELECT html_extract_text(html, '//h4')[1] FROM multi_report WHERE benchmark = 'NDX';
----
Benchmark is NDX |  Generated by QuantStats-RS (v. 0.1.0)

query T
SELECT array_to_string(html_extract_text(html, '//div[@id="right"]/table[1]//thead/tr/th'), ' | ')
FROM multi_report WHERE benchmark = 'NDX';
----
Metric | NDX | My Fund

# 基准不同，基准那一列的 Sharpe 就不同
query T
SELECT (SELECT html_extract_text(html, '//div[@id="right"]/table[1]//tr[td[1]="Sharpe"]/td')[2] FROM multi_report WHERE benchmark = 'SPX')
     <> (SELECT html_extract_text(html, '//div[@id="right"]/table[1]//tr[td[1]="Sharpe"]/td')[2] FROM multi_report WHERE benchmark = 'NDX') AS differ;
----
true

# 但策略那一列不变：换基准只换基准侧
query T
SELECT (SELECT html_extract_text(html, '//div[@id="right"]/table[1]//tr[td[1]="Sharpe"]/td')[3] FROM multi_report WHERE benchmark = 'SPX')
     = (SELECT html_extract_text(html, '//div[@id="right"]/table[1]//tr[td[1]="Sharpe"]/td')[3] FROM multi_report WHERE benchmark = 'NDX') AS same_strategy_column;
----
true

# ============================================================================
# 基准显示名也是列表：按下标对齐 `benchmark`，缺项（短了 / NULL / 空串）退回基准 symbol
# ============================================================================

statement ok
CREATE TABLE titled_reports AS
SELECT (r).benchmark AS benchmark, (r).html AS html FROM (
    SELECT unnest(qs_html_reports(symbol, trade_date, daily_return,
        {'strategy_title': 'My Fund',
         'benchmark': ['SPX', 'NDX'],
         'benchmark_title': ['Index A', 'Index B']}::qs_html_report_options)) AS r
    FROM daily_returns
);

query T
SELECT html_extract_text(html, '//h4')[1] FROM titled_reports WHERE benchmark = 'SPX';
----
Benchmark is Index A |  Generated by QuantStats-RS (v. 0.1.0)

query T
SELECT html_extract_text(html, '//h4')[1] FROM titled_reports WHERE benchmark = 'NDX';
----
Benchmark is Index B |  Generated by QuantStats-RS (v. 0.1.0)

# 指标表的表头也跟着用各自的名字（列顺序：基准在前、策略在后）
query T
SELECT array_to_string(html_extract_text(html, '//div[@id="right"]/table[1]//thead/tr/th'), ' | ')
FROM titled_reports WHERE benchmark = 'NDX';
----
Metric | Index B | My Fund

# 列表短了：第 2 项没给 → 第二个基准退回自己的 symbol（第 1 项照旧生效）
statement ok
CREATE TABLE short_titles AS
SELECT (r).benchmark AS benchmark, (r).html AS html FROM (
    SELECT unnest(qs_html_reports(symbol, trade_date, daily_return,
        {'benchmark': ['SPX', 'NDX'],
         'benchmark_title': ['Index A']}::qs_html_report_options)) AS r
    FROM daily_returns
);

query I
SELECT count(*) FROM short_titles
WHERE position('Benchmark is ' || benchmark || ' |' IN html) > 0;
----
1

query T
SELECT html_extract_text(html, '//h4')[1] FROM short_titles WHERE benchmark = 'SPX';
----
Benchmark is Index A |  Generated by QuantStats-RS (v. 0.1.0)

# NULL 项与空串项同样按「没给」处理：两个都退回 symbol
statement ok
CREATE TABLE blank_titles AS
SELECT (r).benchmark AS benchmark, (r).html AS html FROM (
    SELECT unnest(qs_html_reports(symbol, trade_date, daily_return,
        {'benchmark': ['SPX', 'NDX'],
         'benchmark_title': [NULL, '']}::qs_html_report_options)) AS r
    FROM daily_returns
);

query I
SELECT count(*) FROM blank_titles
WHERE position('Benchmark is ' || benchmark || ' |' IN html) > 0;
----
2

# 文件名里那两段就是报告里显示的名字：解析一次、两处使用（空格按命名规则变成 `_`）
statement ok
CREATE TABLE titled_written AS
SELECT (r).benchmark AS benchmark, (r).file_path AS file_path FROM (
    SELECT unnest(qs_html_reports(symbol, trade_date, daily_return,
        {'strategy_title': 'My Fund',
         'benchmark': ['SPX', 'NDX'],
         'benchmark_title': ['Index A', 'Index B'],
         'output_dir': '__TEST_DIR__'}::qs_html_report_options)) AS r
    FROM daily_returns
);

query T
SELECT list_sort(list(
           regexp_replace(
               regexp_replace(regexp_extract(file_path, '[^/]+$'), '^[0-9]{8}-[0-9]{6}-', ''),
               '-[0-9a-f]{8}\.html$', ''
           )
       ))
FROM titled_written;
----
[My_Fund-Index_A, My_Fund-Index_B]

# ============================================================================
# 显示名没写就退回数据里的名字：strategy_title -> symbol
# ============================================================================

query T
SELECT DISTINCT (r).strategy_title FROM (
    SELECT unnest(qs_html_reports(symbol, trade_date, daily_return,
        {'benchmark': ['SPX']}::qs_html_report_options)) AS r
    FROM daily_returns WHERE symbol <> 'NDX'
);
----
FUND

query T
SELECT array_to_string(html_extract_text(html, '//div[@id="right"]/table[1]//thead/tr/th'), ' | ')
FROM (
    SELECT (r).html AS html FROM (
        SELECT unnest(qs_html_reports(symbol, trade_date, daily_return,
            {'benchmark': ['SPX']}::qs_html_report_options)) AS r
        FROM daily_returns WHERE symbol <> 'NDX'
    )
);
----
Metric | SPX | FUND

# ============================================================================
# 每个 symbol 一套配置 + output_dir：各自的标题、显示名，文件名由函数生成
# ============================================================================

statement ok
CREATE TABLE per_symbol AS
SELECT (r).symbol AS symbol, (r).strategy_title AS strategy_title,
       (r).html AS html, (r).file_path AS file_path
FROM (
    SELECT unnest(qs_html_reports(symbol, trade_date, daily_return,
        {'title': symbol, 'strategy_title': symbol,
         'output_dir': '__TEST_DIR__'}::qs_html_report_options)) AS r
    FROM daily_returns
);

# 三个 symbol 各一份报告，各自的标题带着自己的 symbol
query I
SELECT count(*) FROM per_symbol;
----
3

query T
SELECT html_extract_text(html, '//h1')[1] FROM per_symbol WHERE symbol = 'FUND';
----
FUND 2 Jan, 2024 - 12 Jan, 2024

query T
SELECT html_extract_text(html, '//h1')[1] FROM per_symbol WHERE symbol = 'SPX';
----
SPX 2 Jan, 2024 - 12 Jan, 2024

# 没有基准时文件名是 `<时间>-<策略名>-<随机尾缀>.html`：去掉时间与随机尾缀后只剩策略名
query T
SELECT list_sort(list(
           regexp_replace(
               regexp_replace(regexp_extract(file_path, '[^/]+$'), '^[0-9]{8}-[0-9]{6}-', ''),
               '-[0-9a-f]{8}\.html$', ''
           )
       ))
FROM per_symbol;
----
[FUND, NDX, SPX]

# 落盘内容与返回行里的 html 逐字节一致
query I
SELECT count(*) FROM per_symbol p
WHERE NOT EXISTS (
    SELECT 1 FROM read_text('__TEST_DIR__/*-FUND-*.html') f WHERE md5(f.content) = md5(p.html)
) AND p.symbol = 'FUND';
----
0
