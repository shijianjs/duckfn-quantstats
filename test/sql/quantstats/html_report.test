# name: test/sql/quantstats/html_report.test
# description: duckfn_quantstats_html 单序列报告：命名配置类型（7 字段）、配置参数放最后、缺字段取默认值、必须显式 cast、空输入 NULL、NULL 行跳过、多线程 combine 一致性、GROUP BY 多组，以及配置取值错误
# group: [quantstats]

require duckfn_quantstats

# ============================================================================
# 命名配置类型：加载期由 duckfn 建好，SQL 里可以直接 cast
# ============================================================================

query I
SELECT count(*) FROM duckdb_types() WHERE type_name = 'duckfn_quantstats_html_options';
----
1

# 字段名都不是 SQL 关键字，所以 DuckDB 渲染 typeof 时不加引号
query T
SELECT typeof(NULL::duckfn_quantstats_html_options);
----
STRUCT(title VARCHAR, strategy_title VARCHAR, benchmark_title VARCHAR, rf DOUBLE, periods_per_year UINTEGER, match_dates BOOLEAN, output VARCHAR)

# 两个重载挂在同一个名字下，靠参数个数分派：
#   3 参 = (date, period_return, options)               单序列
#   4 参 = (date, period_return, benchmark, options)     带基准
query I rowsort
SELECT len(parameters) FROM duckdb_functions() WHERE function_name = 'duckfn_quantstats_html';
----
3
4

query T
SELECT DISTINCT function_type FROM duckdb_functions() WHERE function_name = 'duckfn_quantstats_html';
----
aggregate

# 只占一个 SQL 名字：并进函数集之后，旧的独立名字不再注册
statement error
SELECT duckfn_quantstats_html_benchmark(1, 2, 3);
----
Scalar Function with name duckfn_quantstats_html_benchmark does not exist

# ============================================================================
# 固定数据集
# ============================================================================

statement ok
CREATE TABLE daily_returns AS SELECT * FROM (VALUES
    (DATE '2024-01-02', 0.0100::DOUBLE),
    (DATE '2024-01-03', -0.0200::DOUBLE),
    (DATE '2024-01-04', 0.0300::DOUBLE),
    (DATE '2024-01-05', 0.0000::DOUBLE),
    (DATE '2024-01-08', 0.0150::DOUBLE),
    (DATE '2024-01-09', -0.0050::DOUBLE),
    (DATE '2024-01-10', 0.0200::DOUBLE),
    (DATE '2024-01-11', -0.0100::DOUBLE),
    (DATE '2024-01-12', 0.0050::DOUBLE)
) t(trade_date, daily_return);

# ============================================================================
# 配置的三种用法（配置参数在最后，`DuckLazy` 让它只解析一次）
# ============================================================================

# 1) 整体 NULL：全部走 quantstats-rs 自己的默认值（默认标题是 "Strategy Tearsheet"）
query T
SELECT length(duckfn_quantstats_html(trade_date, daily_return, NULL)) > 1000 AS long_enough
FROM daily_returns;
----
true

query T
SELECT position('Strategy Tearsheet' IN duckfn_quantstats_html(trade_date, daily_return, NULL)) > 0 AS has_default_title
FROM daily_returns;
----
true

# 2) 只写部分键：其余键取默认值（这里只给 title）
query T
SELECT position('My Fund' IN duckfn_quantstats_html(
           trade_date, daily_return, {'title': 'My Fund'}::duckfn_quantstats_html_options)) > 0 AS has_custom_title
FROM daily_returns;
----
true

# 3) 显式 NULL 类型化也没有区别
query T
SELECT position('Strategy Tearsheet' IN duckfn_quantstats_html(
           trade_date, daily_return, NULL::duckfn_quantstats_html_options)) > 0 AS has_default_title
FROM daily_returns;
----
true

# 配置里的 periods_per_year 真的传下去了：改了它，报告里的年化数字会变，所以 md5 不同
query T
SELECT md5(duckfn_quantstats_html(trade_date, daily_return, NULL))
    <> md5(duckfn_quantstats_html(trade_date, daily_return,
           {'periods_per_year': 52}::duckfn_quantstats_html_options)) AS differs
FROM daily_returns;
----
true

# 不带 :: 的 struct 字面量是匿名 STRUCT(title VARCHAR)，与配置类型的字段数不匹配，
# 必须显式 cast —— 这正是注册命名类型的意义。
statement error
SELECT duckfn_quantstats_html(trade_date, daily_return, {'title': 'My Fund'}) FROM daily_returns;
----
No function matches the given name and argument types

# ============================================================================
# 边界：空输入 -> SQL NULL；NULL 行被整行跳过
# ============================================================================

query T
SELECT duckfn_quantstats_html(trade_date, daily_return, NULL) IS NULL AS is_null
FROM daily_returns WHERE trade_date > DATE '2100-01-01';
----
true

# 多塞两行「日期为 NULL」和「收益为 NULL」的行，报告应与干净数据完全一致（md5 相同）
statement ok
CREATE TABLE returns_with_nulls AS SELECT * FROM (VALUES
    (DATE '2024-01-02', 0.0100::DOUBLE),
    (NULL, 0.0200::DOUBLE),
    (DATE '2024-01-03', -0.0200::DOUBLE),
    (DATE '2024-01-04', NULL::DOUBLE),
    (DATE '2024-01-04', 0.0300::DOUBLE),
    (DATE '2024-01-05', 0.0000::DOUBLE),
    (DATE '2024-01-08', 0.0150::DOUBLE),
    (DATE '2024-01-09', -0.0050::DOUBLE),
    (DATE '2024-01-10', 0.0200::DOUBLE),
    (DATE '2024-01-11', -0.0100::DOUBLE),
    (DATE '2024-01-12', 0.0050::DOUBLE)
) t(trade_date, daily_return);

query T
SELECT (SELECT md5(duckfn_quantstats_html(trade_date, daily_return, NULL)) FROM returns_with_nulls)
     = (SELECT md5(duckfn_quantstats_html(trade_date, daily_return, NULL)) FROM daily_returns) AS same_as_clean;
----
true

# ============================================================================
# combine：多线程会把一组拆成多个状态再合并，结果必须与单线程完全一致
#
# 20000 行的表跨多个 chunk：单线程一个状态、4 线程多个状态。这也是「combine 只做拼接、排序交给
# ReturnSeries::new」以及「DuckLazy 凭证不跨状态搬运、只搬运解析结果」两条设计的端到端验证 ——
# 凭证被搬进另一个状态并在 finalize 里消费的话，运行时会报 "DuckLazy<T> is stale"。
# ============================================================================

statement ok
CREATE TABLE big_returns AS SELECT
    (DATE '2020-01-01' + CAST(i AS INTEGER))::DATE AS trade_date,
    CAST(0.001 * ((i % 11) - 5) AS DOUBLE) AS daily_return
FROM range(20000) t(i);

statement ok
PRAGMA threads=1;

statement ok
CREATE TABLE big_single_thread AS
SELECT md5(duckfn_quantstats_html(trade_date, daily_return,
           {'title': 'T'}::duckfn_quantstats_html_options)) AS digest
FROM big_returns;

statement ok
PRAGMA threads=4;

query T
SELECT md5(duckfn_quantstats_html(trade_date, daily_return,
           {'title': 'T'}::duckfn_quantstats_html_options)) = (SELECT digest FROM big_single_thread) AS same_as_single_thread
FROM big_returns;
----
true

statement ok
PRAGMA threads=1;

# ============================================================================
# GROUP BY：每个分组一份报告，各自用自己那一组的配置
# ============================================================================

statement ok
CREATE TABLE multi_asset AS SELECT
    CASE WHEN i % 2 = 0 THEN 'AAA' ELSE 'BBB' END AS symbol,
    (DATE '2024-01-01' + CAST(i AS INTEGER))::DATE AS trade_date,
    CAST(0.001 * ((i % 7) - 3) AS DOUBLE) AS daily_return
FROM range(120) t(i);

query I
SELECT count(*) FROM (
    SELECT symbol, duckfn_quantstats_html(
               trade_date, daily_return, {'title': symbol}::duckfn_quantstats_html_options) AS html
    FROM multi_asset GROUP BY symbol
) WHERE length(html) > 1000;
----
2

# 每个分组确实拿到了自己那一组的配置（标题里带着自己的 symbol）
query I
SELECT count(*) FROM (
    SELECT symbol, duckfn_quantstats_html(
               trade_date, daily_return, {'title': symbol}::duckfn_quantstats_html_options) AS html
    FROM multi_asset GROUP BY symbol
) WHERE position(symbol IN html) > 0;
----
2

# ============================================================================
# 配置取值的错误路径
# ============================================================================

# 配置参数在最后：把配置写在最前（本扩展早期的参数顺序）不再匹配任何签名
statement error
SELECT duckfn_quantstats_html({'title': 'My Fund'}::duckfn_quantstats_html_options, trade_date, daily_return)
FROM daily_returns;
----
No function matches the given name and argument types

statement error
SELECT duckfn_quantstats_html(trade_date, daily_return, {'periods_per_year': 0}::duckfn_quantstats_html_options)
FROM daily_returns;
----
periods_per_year must be greater than 0

statement error
SELECT duckfn_quantstats_html(trade_date, daily_return, {'output': ''}::duckfn_quantstats_html_options)
FROM daily_returns;
----
output must not be an empty string
