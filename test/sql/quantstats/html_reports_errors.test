# name: test/sql/quantstats/html_reports_errors.test
# description: 报告函数的错误路径：基准列表的四种写法错误（symbol 不存在、空串、NULL 元素、重复）、基准列表跨 symbol 不一致（含顺序不一致）、多基准时写 benchmark_title、output_dir 空串 / 含 NUL / 配浏览器但非本地路径、配置字面量没 cast，以及旧 API（qs_html_report / 带基准的第 4 个参数 / output 给完整路径）已经整体不存在
# group: [quantstats]

require duckfn_quantstats

statement ok
CREATE TABLE daily_returns AS SELECT
    CASE WHEN i % 4 = 3 THEN 'SPX' WHEN i % 4 = 2 THEN 'NDX' WHEN i % 4 = 0 THEN 'AAA' ELSE 'BBB' END AS symbol,
    (DATE '2024-01-01' + CAST(i // 4 AS INTEGER))::DATE AS trade_date,
    CAST(0.001 * ((i % 7) - 3) AS DOUBLE) AS daily_return
FROM range(160) t(i);

statement ok
CREATE TABLE nav_all AS SELECT
    CASE WHEN i % 4 = 3 THEN 'SPX' WHEN i % 4 = 2 THEN 'NDX' WHEN i % 4 = 0 THEN 'AAA' ELSE 'BBB' END AS symbol,
    (DATE '2024-01-01' + CAST(i // 4 AS INTEGER))::DATE AS trade_date,
    CAST(100.0 + (i % 7) AS DOUBLE) AS nav
FROM range(160) t(i);

# ============================================================================
# 旧 API 整体替换：名字、重载、以及「配置里给完整路径」都不在了
# ============================================================================

query I
SELECT count(*) FROM duckdb_functions()
WHERE function_name IN ('qs_html_report', 'qs_html_report_by_prices', 'qs_html_report_benchmark');
----
0

statement error
SELECT qs_html_report(1, 2, 3);
----
Scalar Function with name qs_html_report does not exist

# 基准不再占一个参数位置：5 参没有签名（基准是配置里的一个键）
statement error
SELECT qs_html_reports(symbol, trade_date, daily_return, NULL, NULL) FROM daily_returns;
----
No function matches the given name and argument types

# 第 4 个参数是配置（STRUCT），不是基准列表：把 ['SPX'] 放在那里匹配不上任何签名
statement error
SELECT qs_html_reports(symbol, trade_date, daily_return, ['SPX']) FROM daily_returns;
----
No function matches the given name and argument types

# 配置的 struct 字面量必须显式 cast（匿名 STRUCT 的字段数与配置类型不同）
statement error
SELECT qs_html_reports(symbol, trade_date, daily_return, {'title': 'My Fund'}) FROM daily_returns;
----
No function matches the given name and argument types

# 落盘只给目录：旧的 output（完整路径）不再是配置字段，cast 时字段名对不上
statement error
SELECT qs_html_reports(symbol, trade_date, daily_return, {'output': 'report.html'}::qs_html_report_options)
FROM daily_returns;
----
STRUCT to STRUCT cast must have at least one matching member

# ============================================================================
# 基准列表：symbol 不存在 / 空串 / NULL 元素 / 重复
# ============================================================================

statement error
SELECT qs_html_reports(symbol, trade_date, daily_return, {'benchmark': ['NOPE']}::qs_html_report_options)
FROM daily_returns;
----
no row for the benchmark symbol 'NOPE'

# 价格路径同理
statement error
SELECT qs_html_reports_by_prices(symbol, trade_date, nav, {'benchmark': ['NOPE']}::qs_html_report_options)
FROM nav_all;
----
no row for the benchmark symbol 'NOPE'

statement error
SELECT qs_html_reports(symbol, trade_date, daily_return, {'benchmark': ['']}::qs_html_report_options)
FROM daily_returns;
----
benchmark must not contain an empty string

statement error
SELECT qs_html_reports(symbol, trade_date, daily_return, {'benchmark': ['SPX', NULL]}::qs_html_report_options)
FROM daily_returns;
----
benchmark must not contain a NULL element

statement error
SELECT qs_html_reports(symbol, trade_date, daily_return, {'benchmark': ['SPX', 'SPX']}::qs_html_report_options)
FROM daily_returns;
----
lists 'SPX' twice

# ============================================================================
# 基准列表跨 symbol 必须一致（元素与顺序都算）
# ============================================================================

# 各标的给不同的基准：谁把谁当基准就没有单一答案
statement error
SELECT qs_html_reports(symbol, trade_date, daily_return,
           {'benchmark': CASE WHEN symbol = 'AAA' THEN ['SPX'] ELSE ['NDX'] END}::qs_html_report_options)
FROM daily_returns;
----
every symbol must use the same benchmark list

# 同一个列表、顺序不同也算不一致（顺序决定报告顺序）
statement error
SELECT qs_html_reports(symbol, trade_date, daily_return,
           {'benchmark': CASE WHEN symbol = 'AAA' THEN ['SPX', 'NDX'] ELSE ['NDX', 'SPX'] END}::qs_html_report_options)
FROM daily_returns;
----
every symbol must use the same benchmark list

# ============================================================================
# 多基准时 benchmark_title 没有单一答案
# ============================================================================

statement error
SELECT qs_html_reports(symbol, trade_date, daily_return,
           {'benchmark': ['SPX', 'NDX'], 'benchmark_title': 'Bench'}::qs_html_report_options)
FROM daily_returns;
----
benchmark_title cannot be set with 2 benchmarks

# 一个基准时可以写（这条通过）
query I
SELECT count(*) FROM (
    SELECT unnest(qs_html_reports(symbol, trade_date, daily_return,
                   {'benchmark': ['SPX'], 'benchmark_title': 'Bench'}::qs_html_report_options)) AS r
    FROM daily_returns
);
----
3

# ============================================================================
# 配置取值的错误路径
# ============================================================================

# 价格路径：基准只有一个点，差分不出收益率 —— 基准是配置里明确要的，所以这是报错
statement error
SELECT qs_html_reports_by_prices(symbol, trade_date, nav, {'benchmark': ['SPX']}::qs_html_report_options)
FROM nav_all WHERE symbol = 'AAA' OR (symbol = 'SPX' AND trade_date = DATE '2024-01-01');
----
produced no returns

statement error
SELECT qs_html_reports(symbol, trade_date, daily_return, {'periods_per_year': 0}::qs_html_report_options)
FROM daily_returns;
----
periods_per_year must be greater than 0

statement error
SELECT qs_html_reports(symbol, trade_date, daily_return, {'output_dir': ''}::qs_html_report_options)
FROM daily_returns;
----
output_dir must not be an empty string

# 目录里有 NUL 字节：转成 C 字符串时就失败，不进入文件系统
statement error
SELECT qs_html_reports(symbol, trade_date, daily_return,
           {'output_dir': 'a' || chr(0) || 'b'}::qs_html_report_options)
FROM daily_returns WHERE symbol = 'AAA';
----
contains a NUL byte

# 浏览器只能打开本地文件：output_dir 指向 s3:// 这类 VFS 路径时直接报错，而且要报在渲染之前
# （这里连 httpfs 都没装，报的必须是配置错误而不是写入错误）
statement error
SELECT qs_html_reports(symbol, trade_date, daily_return,
           {'benchmark': ['SPX'],
            'output_dir': 's3://bucket/reports',
            'open_in_browser': true}::qs_html_report_options)
FROM daily_returns;
----
only local file paths can be opened in a browser
