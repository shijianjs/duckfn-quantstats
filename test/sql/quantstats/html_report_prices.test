# name: test/sql/quantstats/html_report_prices.test
# description: qs_html_report_by_prices 价格/净值路径：与「先在 SQL 里用 lag 差分再走收益率路径」的结果逐字节一致，以及带基准、前值为 0 时跳过、单点/空输入返回 NULL 与错误路径
# group: [quantstats]

require duckfn_quantstats

# 同一个名字下两个签名：3 参（单序列）与 4 参（带基准）
query I rowsort
SELECT len(parameters) FROM duckdb_functions() WHERE function_name = 'qs_html_report_by_prices';
----
3
4

# 价格路径必须另起一个名字：`(date, price, options)` 与 `(date, period_return, options)`
# 的类型序列完全一样（都是 DATE, DOUBLE, STRUCT），同一个名字下无法分派。
# 这里顺带钉住两个名字都在、各有两个签名。
query I rowsort
SELECT len(parameters) FROM duckdb_functions() WHERE function_name = 'qs_html_report';
----
3
4

# ============================================================================
# 数据：一张净值表（一行 = 一天）
# ============================================================================

statement ok
CREATE TABLE nav_table AS SELECT * FROM (VALUES
    (DATE '2024-01-02', 100.00::DOUBLE),
    (DATE '2024-01-03', 101.00::DOUBLE),
    (DATE '2024-01-04', 98.98::DOUBLE),
    (DATE '2024-01-05', 101.95::DOUBLE),
    (DATE '2024-01-08', 103.48::DOUBLE),
    (DATE '2024-01-09', 102.96::DOUBLE),
    (DATE '2024-01-10', 105.02::DOUBLE),
    (DATE '2024-01-11', 103.97::DOUBLE),
    (DATE '2024-01-12', 104.49::DOUBLE)
) t(trade_date, nav);

# ============================================================================
# 核心断言：价格路径与「SQL 里先差分好」的收益率路径**逐字节一致**
#
# 注意窗口函数不能直接写进聚合调用（DuckDB 会报
# `aggregate function calls cannot contain window function calls`），所以参照那一侧必须先在子查询里
# 算好 —— 这也正是价格这个快捷方式存在的理由。
# ============================================================================

statement ok
CREATE TABLE report_from_prices AS
SELECT qs_html_report_by_prices(trade_date, nav, NULL) AS html FROM nav_table;

statement ok
CREATE TABLE report_from_returns AS
SELECT qs_html_report(trade_date, period_return, NULL) AS html
FROM (
    SELECT trade_date, nav / lag(nav) OVER (ORDER BY trade_date) - 1.0 AS period_return
    FROM nav_table
);

query T
SELECT length(html) > 1000 AND md5(html) = (SELECT md5(html) FROM report_from_returns)
FROM report_from_prices;
----
true

# ============================================================================
# 边界：一行都没有、点数不足 2 个，都按「没有有效行」返回 NULL
# ============================================================================

query T
SELECT qs_html_report_by_prices(trade_date, nav, NULL) IS NULL AS is_null
FROM nav_table WHERE trade_date > DATE '2100-01-01';
----
true

query T
SELECT qs_html_report_by_prices(trade_date, nav, NULL) IS NULL AS is_null
FROM nav_table WHERE trade_date = DATE '2024-01-02';
----
true

# 前值为 0 时该点被跳过，但后面的点仍然和它自己的前一个点比（四个点 -> 只剩两个收益）。
# 参照值用同样的算式算出来，不要手写 0.1 这种字面量：110/100 - 1 在 IEEE754 里并不等于 0.1。
statement ok
CREATE TABLE nav_with_zero AS SELECT * FROM (VALUES
    (DATE '2024-01-02', 0.0::DOUBLE),
    (DATE '2024-01-03', 100.0::DOUBLE),
    (DATE '2024-01-04', 110.0::DOUBLE),
    (DATE '2024-01-05', 121.0::DOUBLE)
) t(trade_date, nav);

query T
SELECT (SELECT md5(html) FROM (
            SELECT qs_html_report_by_prices(trade_date, nav, NULL) AS html FROM nav_with_zero))
     = (SELECT md5(html) FROM (
            SELECT qs_html_report(trade_date, period_return, NULL) AS html
            FROM (VALUES
                (DATE '2024-01-04', 110.0::DOUBLE / 100.0::DOUBLE - 1.0),
                (DATE '2024-01-05', 121.0::DOUBLE / 110.0::DOUBLE - 1.0)
            ) t(trade_date, period_return)));
----
true

# 输入乱序也没关系：函数内部先按日期排序再差分
query T
SELECT md5(qs_html_report_by_prices(trade_date, nav, NULL))
     = (SELECT md5(html) FROM report_from_prices) AS same_as_sorted
FROM (SELECT * FROM nav_table ORDER BY trade_date DESC);
----
true

# ============================================================================
# 带基准：策略与基准都是价格/净值，两侧各差分一次
# ============================================================================

statement ok
CREATE TABLE benchmark_nav AS SELECT * FROM (VALUES
    (DATE '2024-01-02', 200.0::DOUBLE),
    (DATE '2024-01-03', 200.4::DOUBLE),
    (DATE '2024-01-04', 200.8::DOUBLE),
    (DATE '2024-01-05', 200.6::DOUBLE),
    (DATE '2024-01-08', 201.0::DOUBLE),
    (DATE '2024-01-09', 201.3::DOUBLE),
    (DATE '2024-01-10', 201.1::DOUBLE),
    (DATE '2024-01-11', 201.5::DOUBLE),
    (DATE '2024-01-12', 201.8::DOUBLE)
) t(trade_date, nav);

# 基准点与匿名 STRUCT(date DATE, price DOUBLE)[] 完全一致，不需要 cast
statement ok
CREATE TABLE benchmark_price_series AS
SELECT list({'date': trade_date, 'price': nav}) AS series FROM benchmark_nav;

query T
SELECT typeof(series) FROM benchmark_price_series;
----
STRUCT(date DATE, price DOUBLE)[]

query T
SELECT length(qs_html_report_by_prices(n.trade_date, n.nav, b.series, NULL)) > 1000 AS ok
FROM nav_table n, benchmark_price_series b;
----
true

# 与「两侧都先差分好、再走收益率路径」逐字节一致
statement ok
CREATE TABLE benchmark_return_series AS
SELECT list({'date': trade_date, 'period_return': period_return}) AS series
FROM (
    SELECT trade_date, nav / lag(nav) OVER (ORDER BY trade_date) - 1.0 AS period_return
    FROM benchmark_nav
) WHERE period_return IS NOT NULL;

query T
SELECT (SELECT md5(html) FROM (
            SELECT qs_html_report_by_prices(n.trade_date, n.nav, b.series, NULL) AS html
            FROM nav_table n, benchmark_price_series b))
     = (SELECT md5(html) FROM (
            SELECT qs_html_report(s.trade_date, s.period_return, b.series, NULL) AS html
            FROM (SELECT trade_date, nav / lag(nav) OVER (ORDER BY trade_date) - 1.0 AS period_return
                  FROM nav_table) s,
                 benchmark_return_series b
            WHERE s.period_return IS NOT NULL));
----
true

# ============================================================================
# GROUP BY：每个标的一份报告
# ============================================================================

statement ok
CREATE TABLE nav_multi AS SELECT
    CASE WHEN i % 2 = 0 THEN 'AAA' ELSE 'BBB' END AS fund,
    (DATE '2024-01-01' + CAST(i // 2 AS INTEGER))::DATE AS trade_date,
    CAST(100.0 + (i % 7) AS DOUBLE) AS nav
FROM range(240) t(i);

query I
SELECT count(*) FROM (
    SELECT fund, qs_html_report_by_prices(trade_date, nav, NULL) AS html
    FROM nav_multi GROUP BY fund
) WHERE length(html) > 1000;
----
2

# ============================================================================
# 错误路径
# ============================================================================

# 基准为 NULL（前缀同样是宏生成的 `SQL_NAME`，见 benchmark 那份测试的说明）
statement error
SELECT qs_html_report_by_prices(n.trade_date, n.nav, NULL, NULL)
FROM nav_table n, benchmark_price_series b;
----
qs_html_report_by_prices: the benchmark list must not be NULL

# 基准为空列表
statement error
SELECT qs_html_report_by_prices(n.trade_date, n.nav,
           []::STRUCT(date DATE, price DOUBLE)[], NULL)
FROM nav_table n, benchmark_price_series b;
----
the benchmark list is empty

# 基准价格只有一个点，差分不出任何收益率
statement error
SELECT qs_html_report_by_prices(n.trade_date, n.nav,
           (SELECT list({'date': trade_date, 'price': nav}) FROM benchmark_nav WHERE trade_date = DATE '2024-01-02'),
           NULL)
FROM nav_table n, benchmark_price_series b;
----
qs_html_report_by_prices: the benchmark prices produced no returns

# 参数顺序不对
statement error
SELECT qs_html_report_by_prices(NULL, n.trade_date, n.nav)
FROM nav_table n, benchmark_price_series b;
----
No function matches the given name and argument types

# 收益率的那个名字不接受价格语义的字段名：基准列表的键必须是 period_return
statement error
SELECT qs_html_report(n.trade_date, n.nav, b.series, NULL)
FROM nav_table n, benchmark_price_series b;
----
No function matches the given name and argument types
